{
  "name": "@token-wallet/app",
  "private": true,
  "version": "0.1.0",
  "description": "token-wallet 桌面部件壳 — Electron + React 19 (托盘 + 弹出面板 + 主题)",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node electron/scripts/dev.mjs",
    "dev:web": "vite",
    "build": "node electron/scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=browser-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@token-wallet/core": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
